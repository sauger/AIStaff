APP_NAME="Skill Agent Loop Service"
DATABASE_URL="sqlite:///./skill_agent_loop.db"
APP_SECRET="change-me-in-development"
DEMO_MODEL_BASE_URL="http://localhost:52010/v1"
DEMO_MODEL_NAME="qwen3.6-27b"
DEMO_MODEL_API_KEY=""
MODEL_THINKING_MODE=""
MODEL_THINKING_MODELS=""
TOOL_TIMEOUT_SECONDS="8"
EXTERNAL_TASK_POLL_SECONDS="2"
# Optional externally reachable StaffDeck base URL used for provider callbacks.
# Production deployments should use HTTPS. Leave empty for polling-only tracking.
EXTERNAL_TASK_CALLBACK_BASE_URL=""
A2A_TASK_TIMEOUT_SECONDS="600"
A2A_POLL_INTERVAL_SECONDS="0.5"
# Optional local A2A server backed by Codex CLI. Keep disabled unless the host
# has an authenticated Codex CLI installation.
CODEX_A2A_ENABLED="false"
CODEX_A2A_COMMAND="codex"
CODEX_A2A_WORKSPACE_ROOT=""
CODEX_A2A_TIMEOUT_SECONDS="1800"
CODEX_A2A_TOKEN=""
TOOL_BASE_URL="http://localhost:5173"
# Public URL used for IM file download links; falls back to TOOL_BASE_URL.
PUBLIC_BASE_URL=""
# Only for local development: allow localhost/private download links.
ALLOW_LOCAL_ARTIFACT_LINKS="false"
# Optional absolute directory for staged chat attachments; defaults to user data.
HARNESS_UPLOADS_PATH=""
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
GENERAL_SKILL_RUNTIME_PYTHON=""
GENERAL_SKILL_RUNTIME_VENV=""
GENERAL_SKILL_RUNTIME_PACKAGES="requests,httpx"
GENERAL_SKILL_RUNTIME_AUTO_INSTALL="true"
CHANNEL_SECRET=""
STAFFDECK_ROLE="all"
WECHAT_ILINK_BASE_URL="https://ilinkai.weixin.qq.com"
CHANNEL_DELIVERY_POLL_SECONDS="1.0"
CHANNEL_DELIVERY_MAX_ATTEMPTS="8"
CHANNEL_RICH_RENDER_ENABLED="true"

# Phase 1 only: comma-separated channels allowed to write knowledge without
# manager grants. Leave empty to enforce the normal permission model.
KNOWLEDGE_OPEN_WRITE_CHANNELS=""
